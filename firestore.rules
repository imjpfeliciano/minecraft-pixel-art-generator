rules_version = '2';

// All Firestore access goes through the Next.js server via the Admin SDK,
// which bypasses these rules. These rules exist solely to block any direct
// client-side access to Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
